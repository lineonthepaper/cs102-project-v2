# Smart Attendance System Environment Configuration
  # Development environment settings
  # COPY THIS FILE TO 'env' AND FILL IN YOUR ACTUAL VALUES

  # Application Configuration
  APP_PORT=8080
  APP_PROFILE=prod

  # Security Configuration
  JWT_SECRET=your-jwt-secret-key-here-generate-a-random-string
  JWT_EXPIRATION=3600

  # Supabase Configuration (REQUIRED - get from Supabase dashboard)
  APP_SUPABASE_URL=https://your-project.supabase.co
  APP_SUPABASE_KEY=your-supabase-anon-key-here
  APP_SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

  # Supabase Database Configuration
  # Get these from: Project Settings → Database → Connection String
  # Use DIRECT connection, not pooler
  SUPABASE_DB_HOST=db.your-project.supabase.co
  SUPABASE_DB_PORT=5432
  SUPABASE_DB_NAME=postgres
  SUPABASE_DB_USERNAME=postgres
  SUPABASE_DB_PASSWORD=your-database-password-here

  # Face Recognition Configuration
  FACE_CONFIDENCE_THRESHOLD=0.7
  FACE_MAX_FACES=10
  FACE_MODEL_PATH=models/

  # Logging Configuration
  LOG_LEVEL=INFO
  LOG_FILE_PATH=logs/smart-attendance.log

  # File Upload Configuration
  MAX_FILE_SIZE=10MB

  # Development Configuration
  DEV_RELOAD=true
  DEV_H2_CONSOLE=false

